#%Module######################################################################
##
##     hdf5_1.14.6_openmpi4.1.7 modulefile
##
## build info:
## module load openmpi/4.1.7
## export CC=mpicc
## export CXX=mpicxx
## export FC=mpif90
## ./configure --prefix=/home/ec2-user/software/hdf5-1.14.6/install \
##   --enable-unsupported \
##   --enable-parallel \
##   --enable-fortran \
##   --enable-cxx \
##   --with-zlib=/home/ec2-user/software/zlib-1.3.1/install \
##   --with-szlib=/home/ec2-user/software/szip-2.1.1/install
## make -j
## make install
##
###########################################################################

set basepath  /home/ec2-user/software/hdf5-1.14.6/install
set zlibpath  /home/ec2-user/software/zlib-1.3.1/install
set szippath  /home/ec2-user/software/szip-2.1.1/install

# Require correct MPI version
if { ![is-loaded openmpi/4.1.7] } {
    module load openmpi/4.1.7
}

# Determine lib vs lib64
set libdir $basepath/lib
if { [file isdirectory $basepath/lib64] } {
    set libdir $basepath/lib64
}

set zliblib $zlibpath/lib
if { [file isdirectory $zlibpath/lib64] } {
    set zliblib $zlibpath/lib64
}

set sziplib $szippath/lib
if { [file isdirectory $szippath/lib64] } {
    set sziplib $szippath/lib64
}

# Core HDF5 paths
prepend-path PATH            $basepath/bin
prepend-path LD_LIBRARY_PATH $libdir
prepend-path LIBRARY_PATH    $libdir
prepend-path CPATH           $basepath/include
prepend-path FPATH           $basepath/include
prepend-path INCLUDE         $basepath/include
prepend-path PKG_CONFIG_PATH $libdir/pkgconfig
prepend-path CMAKE_PREFIX_PATH $basepath

# Dependency exposure (useful for downstream builds like netCDF)
prepend-path LD_LIBRARY_PATH $zliblib
prepend-path LIBRARY_PATH    $zliblib
prepend-path CPATH           $zlibpath/include
prepend-path PKG_CONFIG_PATH $zliblib/pkgconfig

prepend-path LD_LIBRARY_PATH $sziplib
prepend-path LIBRARY_PATH    $sziplib
prepend-path CPATH           $szippath/include
prepend-path PKG_CONFIG_PATH $sziplib/pkgconfig

# Helpful environment variables
setenv HDF5_ROOT        $basepath
setenv HDF5_DIR         $basepath
setenv HDF5_HOME        $basepath
setenv HDF5_INCLUDE_DIR $basepath/include
setenv HDF5_LIB_DIR     $libdir

# Help text
proc ModulesHelp { } {
    puts stderr "\
This module provides HDF5 version 1.14.6 binaries and libraries.
Built with OpenMPI 4.1.7, zlib 1.3.1, and szip 2.1.1.

Install path:
  /home/ec2-user/software/hdf5-1.14.6/install

Parallel HDF5: enabled
Thread-safety: disabled (standard for MPI builds)
"
}

module-whatis "HDF5 1.14.6 (parallel, OpenMPI 4.1.7)"